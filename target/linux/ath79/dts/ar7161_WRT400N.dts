/dts-v1/;

#include "ar7100.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "linksys,wrt400n", "qca,ar7161";
	model = "Linksys WRT400N";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	aliases {
		label-mac-device = &eth0;
		};
	
	leds {
		compatible = "gpio-leds";

		led_power {
			label = "wrt400n:power";
			/* GPIO 1, активный высокий, включён по умолчанию */
			gpios = <&gpio 1 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		wps_blue {
			label = "wrt400n:wps_blue";
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
		};

		wps_amber {
			label = "wrt400n:wps_amber";
			gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
		};

		wlan {
			label = "wrt400n:wlan";
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
		};

		wlsec {
			label = "wlsec";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};
	};
};


&pcie0 {
	status = "okay";

	ath9k0: wifi@0,11 {
		compatible = "pci168c,0029";
		reg = <0x8800 0 0 0 0>;
		qca,no-eeprom;
		#gpio-cells = <2>;
		gpio-controller;
	};

	ath9k1: wifi@0,12 {
		compatible = "pci168c,0029";
		reg = <0x9000 0 0 0 0>;
		qca,no-eeprom;
		#gpio-cells = <2>;
		gpio-controller;
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "uboot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "env";
				reg = <0x030000 0x010000>;
			};

			partition@40000 {
				label = "linux";
				reg = <0x040000 0x140000>;
			};

			partition@240000 {
				label = "rootfs";
				reg = <0x180000 0xe60000>;
			};

			partition@7b0000 {
				label = "nvram";
				reg = <0xfe0000 0x010000>;
				read-only;
			};
			
	      		caldata: partition@7f0000 {
				label = "caldata";
				reg = <0xff0000 0x010000>;
				read-only;
			};
		
			partition@40000_firmware {
				label = "firmware";
				reg = <0x040000 0xfa0000>;
			};
		};	
	};
};


&mdio0 {
	status = "okay";

	phy0: ethernet-phy@4 {
		reg = <4>;
		phy-mode = "rmii";
	};
};

&eth0 {
	status = "okay";

	pll-data = <0x11110000 0x00001099 0x00991099>;
	
	phy-mode = "rmii";

	
	fixed-link {
		speed = <100>;
		full-duplex;
	};
};

&eth1 {
	status = "okay";

	pll-data = <0x11110000 0x00001099 0x00991099>;
	
	phy-handle = <&phy0>;
	phy-mode = "rmii";

	
};

